// Prisma schema for the Fathom clone.
// Priority order follows research/fathom-teardown.md -> "## What I'd build first":
//   1. Meeting + TranscriptLine (transcript <-> playback sync)
//   2. Summary (AI summary generation, 2 templates)
//   3. ActionItem (extraction, owner/due date)
//   4. Search is done via simple ILIKE over Meeting.title / TranscriptLine.text — no
//      extra schema needed for that.
//   5. Highlight (lightweight timestamp + label + note, no real clip generation)
//   6. ShareLink (single access tier: anyone with the link)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js (Google OAuth only — the one piece of onboarding built for real) ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]
  meetings Meeting[]

  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Core product data ---

enum MeetingSource {
  SEED   // bundled sample meeting shipped with the app
  UPLOAD // user uploaded a recording (stub for real bot-join capture)
}

enum MediaType {
  AUDIO
  VIDEO
}

model Meeting {
  id          String        @id @default(cuid())
  ownerId     String
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  occurredAt  DateTime
  durationSec Int
  mediaUrl    String
  mediaType   MediaType
  source      MeetingSource @default(UPLOAD)
  createdAt   DateTime      @default(now())

  participants    Participant[]
  transcriptLines TranscriptLine[]
  summaries       Summary[]
  actionItems     ActionItem[]
  highlights      Highlight[]
  shareLinks      ShareLink[]

  @@index([ownerId])
}

model Participant {
  id     String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  name   String
  email  String?
  isHost Boolean @default(false)

  transcriptLines TranscriptLine[]

  @@index([meetingId])
}

model TranscriptLine {
  id            String       @id @default(cuid())
  meetingId     String
  meeting       Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  participantId String?
  participant   Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  speakerName   String
  startMs       Int
  endMs         Int
  text          String       @db.Text
  order         Int

  @@index([meetingId, order])
}

enum SummaryTemplate {
  GENERAL // "Enhanced"-style general purpose template
  SALES   // niche template, demonstrates the template mechanism
}

model Summary {
  id         String          @id @default(cuid())
  meetingId  String
  meeting    Meeting         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  template   SummaryTemplate
  content    String          @db.Text // markdown
  generatedAt DateTime       @default(now())

  @@index([meetingId])
}

model ActionItem {
  id        String    @id @default(cuid())
  meetingId String
  meeting   Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  text      String    @db.Text
  owner     String?
  dueDate   DateTime?
  done      Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([meetingId])
}

enum HighlightLabel {
  HIGHLIGHT
  POSITIVE_REACTION
  NEEDS_REVIEW
  FEEDBACK
}

model Highlight {
  id          String         @id @default(cuid())
  meetingId   String
  meeting     Meeting        @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  timestampMs Int
  label       HighlightLabel @default(HIGHLIGHT)
  note        String?        @db.Text
  createdAt   DateTime       @default(now())

  @@index([meetingId])
}

// Single access tier by design ("anyone with the link") — see build-plan §6.
model ShareLink {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  token     String   @unique
  createdAt DateTime @default(now())

  @@index([meetingId])
}
