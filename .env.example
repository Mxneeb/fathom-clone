# Copy this file to .env and fill in real values.
# This repo is public — never commit .env, only .env.example.

# Postgres connection string (Neon, or any Postgres host)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# Groq API — summary + action item generation (chat completions), and
# real Whisper transcription for uploaded recordings (see src/lib/ai.ts)
GROQ_API_KEY="gsk_..."

# Vercel Blob — uploaded recordings go straight from the browser to Blob
# storage (see src/app/api/blob/upload-url/route.ts), bypassing Vercel's
# ~4.5MB request body cap for Serverless Functions. Auto-populated when
# you run `vercel blob create-store` / link a store to this project.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
